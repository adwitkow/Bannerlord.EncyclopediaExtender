<Prefab>
  <Parameters>
    <Parameter
      Name="ScopeId"
      DefaultValue="DictionaryScope" />
    <Parameter
      Name="MarginTop"
      DefaultValue="20" />
  </Parameters>

  <Window>
    <ListPanel
      WidthSizePolicy="StretchToParent"
      HeightSizePolicy="CoverChildren"
      StackLayout.LayoutMethod="VerticalTopToBottom">
      
      <Children>
        <EncyclopediaDivider
          MarginTop="*MarginTop"
          Parameter.Title="@Title"
          Parameter.ItemList="..\DictionaryContainer\DictionaryGrid"
          GamepadNavigationIndex="0" />

        <NavigationScopeTargeter
          ScopeID="*ScopeId"
          ScopeParent="..\DictionaryContainer"
          ScopeMovements="Horizontal"
          ExtendDiscoveryAreaTop="-10" />

        <Widget
          Id="DictionaryContainer"
          HeightSizePolicy="CoverChildren"
          WidthSizePolicy="StretchToParent">
          
          <Children>
            <GridWidget
              Id="DictionaryGrid"
              DataSource="{Items}"
              WidthSizePolicy="CoverChildren"
              HeightSizePolicy="CoverChildren"
              DefaultCellWidth="275"
              DefaultCellHeight="30"
              HorizontalAlignment="Left"
              ColumnCount="2"
              MarginTop="10"
              MarginLeft="15">
              
              <ItemTemplate>
                <ListPanel
                  HeightSizePolicy="CoverChildren"
                  WidthSizePolicy="CoverChildren"
                  MarginLeft="15"
                  MarginTop="3">
                  
                  <Children>
                    <AutoHideRichTextWidget
                      HeightSizePolicy="CoverChildren"
                      WidthSizePolicy="CoverChildren"
                      VerticalAlignment="Bottom"
                      Brush="Encyclopedia.Stat.DefinitionText"
                      Text="@Definition"
                      MarginRight="5" />
                    <AutoHideRichTextWidget
                      HeightSizePolicy="CoverChildren"
                      WidthSizePolicy="CoverChildren"
                      VerticalAlignment="Bottom"
                      Brush="Encyclopedia.Stat.ValueText"
                      Text="@Value" />
                  </Children>
                </ListPanel>
              </ItemTemplate>
            </GridWidget>
          </Children>
        </Widget>
      </Children>
    </ListPanel>
  </Window>
</Prefab>